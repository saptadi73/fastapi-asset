APP_NAME=Asset Management API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/asset_management
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:postgres@localhost:5432/asset_management
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=["localhost","127.0.0.1"]
